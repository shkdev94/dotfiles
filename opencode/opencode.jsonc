{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-sol",
  "default_agent": "build",
  "shell": "/bin/zsh",
  // Homebrew owns the executable; its tap is pinned by flake.lock.
  "update": "disable",
  "providers": {
    "openai": {
      "models": {
        "gpt-6-astra": {
          "limit": { "context": 872000, "input": 872000 },
          "settings": { "reasoningEffort": "xhigh" }
        },
        "gpt-6-sol": {
          "name": "GPT-6 Sol",
          "limit": { "context": 872000, "input": 872000 },
          "settings": { "reasoningEffort": "xhigh" }
        }
      }
    }
  },
  // Preserve the Codex context budget; OpenCode accounts for output/headroom itself.
  "compaction": {
    "auto": true,
    "buffer": 72000
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"]
      },
      "figma": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp",
        "oauth": false
      },
      "browser-use": {
        "type": "local",
        "command": ["/run/current-system/sw/bin/browser-use", "--mcp"]
      }
    }
  }
}
