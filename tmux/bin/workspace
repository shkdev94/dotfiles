#!/usr/bin/env zsh
set -euo pipefail

self=${0:A}
bin=${self:h}

current_tab() {
  print -r -- "$(<"$WS_TAB_FILE")"
}

case ${1:-} in
  --render)
    if [[ $(current_tab) == worktrees ]]; then
      exec "$bin/wt-picker" --render "${2:-}"
    else
      exec "$bin/codex-account-picker" --render "${2:-}"
    fi
    ;;
  --preview)
    case ${3:-} in
      h | w) exec "$bin/wt-preview" "${2:-}" ;;
      a) exec "$bin/codex-account-picker" --preview "${2:-}" ;;
      g | e) exit 0 ;;
    esac
    exit 0
    ;;
  --toggle)
    if [[ $(current_tab) == worktrees ]]; then
      print -r -- accounts > "$WS_TAB_FILE"
    else
      "$bin/wt-list" > "$WT_CACHE"
      print -r -- worktrees > "$WS_TAB_FILE"
    fi
    exit 0
    ;;
  --refresh)
    [[ $(current_tab) == worktrees ]] && "$bin/wt-list" > "$WT_CACHE"
    exit 0
    ;;
  --header)
    if [[ $(current_tab) == worktrees ]]; then
      print -r -- $'\e[7m 1 Worktrees \e[0m   2 Accounts'
    else
      print -r -- $'1 Worktrees   \e[7m 2 Accounts \e[0m'
    fi
    exit 0
    ;;
  --footer)
    if [[ $(current_tab) == worktrees ]]; then
      print -r -- 'enter: 열기   tab: 전환   ctrl-r: 새로고침   esc: 닫기'
    else
      print -r -- 'enter: 전환   ctrl-a: 추가   ctrl-g: 기기 코드   ctrl-d: 삭제   ctrl-l: 로그아웃   tab: 전환'
    fi
    exit 0
    ;;
  --prompt)
    if [[ $(current_tab) == worktrees ]]; then
      print -r -- 'worktree ❯ '
    else
      print -r -- 'codex ❯ '
    fi
    exit 0
    ;;
esac

tab=${1:-worktrees}
case $tab in
  worktrees | accounts) ;;
  *) print -u2 -- "알 수 없는 탭: $tab"; exit 2 ;;
esac

tab_file=$(mktemp -t workspace-tab) || exit 1
cache=$(mktemp -t workspace-wt) || {
  rm -f -- "$tab_file"
  exit 1
}
trap 'rm -f -- "$tab_file" "$cache"' EXIT
print -r -- "$tab" > "$tab_file"
"$bin/wt-list" > "$cache"
export WS_TAB_FILE=$tab_file WT_CACHE=$cache

pause() {
  print
  print -n -- '아무 키나 누르면 Workspace로 돌아갑니다...'
  read -k 1 || true
  print
}

tab_actions="execute-silent($self --toggle)+clear-query+reload-sync($self --render {q})+transform-header($self --header)+transform-footer($self --footer)+transform-prompt($self --prompt)+refresh-preview"

while true; do
  selection=$(fzf --disabled --ansi --cycle --layout=reverse --border=rounded \
    --border-label=Workspace --header-first \
    --delimiter=$'\t' --with-nth=1 \
    --bind "start:reload-sync($self --render {q})" \
    --bind "change:reload($self --render {q})" \
    --bind "tab,shift-tab:$tab_actions" \
    --bind "ctrl-r:execute-silent($self --refresh)+reload-sync($self --render {q})" \
    --bind "load:transform(test {3} = h -o {3} = g && echo down)" \
    --bind "down,ctrl-j,ctrl-n:down+transform(test {3} = h -o {3} = g && echo down)" \
    --bind "up,ctrl-k,ctrl-p:up+transform(test {3} = h -o {3} = g && echo up)" \
    --expect=ctrl-a,ctrl-g,ctrl-d,ctrl-l \
    --prompt="$("$self" --prompt)" \
    --header="$("$self" --header)" \
    --footer="$("$self" --footer)" \
    --preview="$self --preview {2} {3}" --preview-window=right:35% \
    --color='fg:#abb2bf,bg:-1,hl:#61afef,fg+:#e5e5e5,bg+:#3e4452,hl+:#61afef,info:#565c64,prompt:#98c379,pointer:#e06c75,marker:#e5c07b,spinner:#c678dd,header:#565c64,border:#3e4452,gutter:-1') || exit 0

  key=${selection%%$'\n'*}
  row=''
  [[ $selection == *$'\n'* ]] && row=${selection#*$'\n'}
  display=${row%%$'\t'*}
  value=''
  kind=''
  if [[ $row == *$'\t'* ]]; then
    rest=${row#*$'\t'}
    value=${rest%%$'\t'*}
    kind=${rest##*$'\t'}
  fi

  if [[ $key == '' ]]; then
    case $kind in
      h | w)
        "$bin/wt-open" "$value"
        exit $?
        ;;
      a) action=(switch "$value") ;;
      *) print -r -- '선택할 항목이 없습니다.'; pause; continue ;;
    esac
  else
    if [[ $(current_tab) != accounts ]]; then
      print -r -- '계정 작업은 Accounts 탭에서 사용하세요.'
      pause
      continue
    fi
    case $key in
      ctrl-a) action=(add) ;;
      ctrl-g) action=(add-device) ;;
      ctrl-l) action=(logout) ;;
      ctrl-d)
        if [[ $kind != a ]]; then
          print -r -- '삭제할 계정을 선택하세요.'
          pause
          continue
        fi
        action=(remove "$value" "$display")
        ;;
      *) continue ;;
    esac
  fi

  if "$bin/codex-account-picker" --action "${action[@]}"; then
    action_status=0
  else
    action_status=$?
  fi
  if (( action_status != 0 )); then
    print -u2 -- '작업이 완료되지 않았습니다.'
  fi
  pause
done
