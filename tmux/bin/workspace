#!/usr/bin/env zsh
set -euo pipefail

self=${0:A}
bin=${self:h}
command_path=${(q)self}

pause() {
  print
  print -n -- '아무 키나 누르면 Workspace로 돌아갑니다...'
  read -k 1 || true
  print
}

case ${1:-} in
  --render)
    exec "$bin/wt-picker" --render "${2:-}"
    ;;
  --preview)
    case ${3:-} in
      h | w) exec "$bin/wt-preview" "${2:-}" ;;
    esac
    exit 0
    ;;
  --refresh)
    "$bin/wt-list" > "$WT_CACHE"
    exit 0
    ;;
  --action)
    value=${2:-} kind=${3:-}
    case $kind in
      h | w)
        if "$bin/wt-open" "$value" "${WS_CLIENT:-}"; then
          if [[ -n ${WS_CLIENT:-} ]]; then
            "$bin/workspace-sidebar" hide "$WS_CLIENT"
          fi
        else
          print -u2 -- 'worktree를 열지 못했습니다.'
          pause
          exit 1
        fi
        ;;
      *) print -r -- '선택할 항목이 없습니다.'; pause ;;
    esac
    exit 0
    ;;
esac

sidebar=0
if [[ ${1:-} == --sidebar ]]; then
  sidebar=1
  shift
elif [[ -n ${TMUX:-} ]]; then
  if [[ $# == 0 ]]; then
    exec "$bin/workspace-sidebar" toggle
  fi
  if [[ $1 != worktrees ]]; then
    print -u2 -- "알 수 없는 Workspace 화면: $1"
    exit 2
  fi
  exec "$bin/workspace-sidebar" show
fi

case ${1:-worktrees} in
  worktrees) ;;
  *) print -u2 -- "알 수 없는 Workspace 화면: $1"; exit 2 ;;
esac

# Keep the Unix socket path short enough for macOS's sockaddr_un limit.
state_dir=$(mktemp -d /tmp/workspace.XXXXXXXX)
trap 'rm -rf -- "$state_dir"' EXIT
trap 'exit 0' HUP INT TERM
export WT_CACHE=$state_dir/worktrees
"$self" --refresh

action_args=()
if (( sidebar )); then
  tmux set-option -p -t "$TMUX_PANE" @workspace-socket "$state_dir/fzf.sock"
  action_args=(--listen="$state_dir/fzf.sock" --id-nth=2,3)
  action_args+=(--bind "enter:execute($command_path --action {2} {3})+clear-query+track-current+reload-sync($command_path --render {q})")
  action_args+=(--bind "esc,ctrl-c:clear-query+execute-silent(${(q)bin}/workspace-sidebar hide ${(q)WS_CLIENT})")
fi

while true; do
  selection=$(fzf --disabled --ansi --read0 --wrap --wrap-sign='      ' --ellipsis='' --cycle --layout=reverse --border=rounded \
    --border-label=Workspace --header-first \
    --delimiter=$'\t' --with-nth=1 \
    --bind "start:reload-sync($command_path --render {q})" \
    --bind "change:untrack-current+reload($command_path --render {q})" \
    --bind "ctrl-r:execute-silent($command_path --refresh)+reload-sync($command_path --render {q})" \
    --bind "load:transform(test {3} = h && echo down)" \
    --bind "down,ctrl-j,ctrl-n:down+transform(test {3} = h && echo down)" \
    --bind "up,ctrl-k,ctrl-p:up+transform(test {3} = h && echo up)" \
    "${action_args[@]}" \
    --prompt='worktree ❯ ' \
    --header='Worktrees' \
    --footer='enter 열기 · ctrl-r 새로고침 · esc 숨김' \
    --color='fg:#abb2bf,bg:-1,hl:#61afef,fg+:#e5e5e5,bg+:#3e4452,hl+:#61afef,info:#565c64,prompt:#98c379,pointer:#e06c75,marker:#e5c07b,spinner:#c678dd,header:#565c64,border:#3e4452,gutter:-1') || exit 0

  row=$selection
  value=''
  kind=''
  if [[ $row == *$'\t'* ]]; then
    rest=${row#*$'\t'}
    value=${rest%%$'\t'*}
    kind=${rest##*$'\t'}
  fi

  "$self" --action "$value" "$kind"
  if [[ $kind == h || $kind == w ]]; then
    exit 0
  fi
done
