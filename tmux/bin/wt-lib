# Shared helpers for wt-* scripts (sourced, not executed).

# Default tmux session name for a worktree path: "<repo>@<worktree dir>",
# just "<repo>" for the main worktree, the directory name when not a git
# checkout. Leading dot dropped, '.'/':' -> '_' (tmux forbids those).
wt_session_name() {
  local dir=$1 common repo n
  if common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    repo=${common:h:t}
    if [[ ${common:h} == $dir ]]; then
      n=$repo                      # main worktree
    else
      n="${repo#.}@${dir:t}"
    fi
  else
    n=${dir:t}
  fi
  n="${n#.}"
  print -r -- "${n//[.:]/_}"
}

# Print the name of the live session whose start directory is $1, if any.
# Sessions are matched by path, not name, so same-named checkouts
# (~/.dotfiles vs ~/projects/dotfiles) never collide.
wt_session_for_path() {
  local n p
  tmux list-sessions -F $'#{session_name}\t#{session_path}' 2>/dev/null |
    while IFS=$'\t' read -r n p; do
      [[ $p == $1 ]] && { print -r -- "$n"; return 0 }
    done
  return 1
}
