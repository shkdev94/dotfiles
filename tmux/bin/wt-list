#!/usr/bin/env zsh
# List git worktrees grouped by repo, one per line:
#   repo<TAB>branch<TAB>path<TAB>live(0|1)<TAB>main(0|1)
# Repos are discovered one level under each WT_ROOTS entry (default:
# ~/projects:~/.dotfiles), deduped by git common dir, so sibling worktree
# checkouts collapse under their main repo.
set -euo pipefail
source "${0:A:h}/wt-lib"

roots=(${(s.:.)${WT_ROOTS:-$HOME/projects:$HOME/.dotfiles}})
live=$(tmux list-sessions -F '#{session_path}' 2>/dev/null || true)

candidates=()
for r in $roots; do
  [[ -d $r ]] || continue
  if [[ -e $r/.git ]]; then candidates+=("$r"); else candidates+=("$r"/*(N/)); fi
done

# Resolve the git common dir without spawning git: .git is either the repo's
# own directory or a "gitdir: <main>/.git/worktrees/<name>" pointer file.
common_dir() {
  if [[ -d $1/.git ]]; then
    print -r -- "$1/.git"
  elif [[ -f $1/.git ]]; then
    local g=$(<"$1/.git"); g=${g#gitdir: }
    [[ $g == */.git/worktrees/* ]] && print -r -- "${g%/worktrees/*}"
  fi
}

typeset -A seen
for d in $candidates; do
  common=$(common_dir "$d"); [[ -n $common ]] || continue
  [[ -n ${seen[$common]:-} ]] && continue
  seen[$common]=1
  repo=${common:h:t}

  wt= branch= prunable=0 is_main=1
  git -C "$d" worktree list --porcelain | while IFS= read -r line; do
    case $line in
      "worktree "*) wt=${line#worktree } ;;
      "branch "*)   branch=${${line#branch }#refs/heads/} ;;
      detached)     branch="${wt:t} (detached)" ;;
      prunable*)    prunable=1 ;;
      "")
        if (( ! prunable )) && [[ -d $wt ]]; then
          l=0; [[ $'\n'$live$'\n' == *$'\n'$wt$'\n'* ]] && l=1
          print -r -- "$repo	$branch	$wt	$l	$is_main"
        fi
        wt= branch= prunable=0 is_main=0
        ;;
    esac
  done
done
