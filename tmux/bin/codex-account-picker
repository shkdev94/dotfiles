#!/usr/bin/env zsh
set -euo pipefail
umask 077

bin=${0:A:h}
login_home=''
cleanup() {
  if [[ -n $login_home && -d $login_home ]]; then
    command rm -r -- "$login_home"
  fi
}
trap cleanup EXIT

render_accounts() {
  local account_json rows row
  account_json=$(codex-auth list --skip-api --json) || return 1
  rows=$(print -r -- "$account_json" | jq -r '
    def clean: tostring | gsub("[\\t\\r\\n]"; " ");
    if (.accounts | length) == 0 then
      ["  등록된 계정이 없습니다.", "", "e"] | @tsv
    else
      .accounts[] |
      (.alias // .account_name // .email // .account_key | clean) as $name |
      (.email // "" | clean) as $email |
      (.plan // "" | clean) as $plan |
      [
        "  " + (if .active then "● " else "  " end) +
        (.number | tostring) + "  " + $name +
        (if $email != "" and $email != $name then "  " + $email else "" end) +
        (if $plan != "" then "  [" + $plan + "]" else "" end),
        .account_key,
        "a"
      ] | @tsv
    end
  ') || return 1
  [[ -n $rows ]] || return 0
  print -rn -- $'\e[1mCodex\e[0m\t\tg\0'
  while IFS= read -r row; do
    print -rn -- "$row"$'\0'
  done <<< "$rows"
}

preview_account() {
  codex-auth list --skip-api --json | jq -r --arg key "$1" '
    .accounts[] | select(.account_key == $key) |
    "Codex account\n\n" +
    "Name: " + (.alias // .account_name // .email // .account_key) + "\n" +
    "Email: " + (.email // "-") + "\n" +
    "Plan: " + (.plan // "-") + "\n" +
    "Status: " + (if .active then "active" else "saved" end)
  '
}

add_account() {
  login_home=$(mktemp -d -t codex-account-login) || return 1

  if ! CODEX_HOME="$login_home" codex login -c 'cli_auth_credentials_store="file"' "$@"; then
    return 1
  fi
  if [[ ! -s "$login_home/auth.json" ]]; then
    print -u2 -- '로그인 파일을 찾지 못했습니다. 계정은 추가되지 않았습니다.'
    return 1
  fi

  codex-auth import "$login_home/auth.json" || return 1
  print -r -- '계정이 추가됐습니다.'
}

switch_account() {
  local account_key=$1 account_json match number active
  account_json=$(codex-auth list --skip-api --json) || return 1
  match=$(print -r -- "$account_json" | jq -r --arg key "$account_key" \
    '.accounts[] | select(.account_key == $key) | [(.number | tostring), (.active | tostring)] | @tsv') || return 1
  if [[ -z $match ]]; then
    print -u2 -- '선택한 계정을 찾지 못했습니다. 목록을 새로고침하세요.'
    return 1
  fi
  number=${match%%$'\t'*}
  active=${match#*$'\t'}
  if [[ $active == true ]]; then
    print -r -- '이미 사용 중인 계정입니다.'
    return 0
  fi

  codex-auth switch "$number" || return 1
  print -r -- '실행 중인 Codex는 재시작해야 새 계정을 사용합니다.'
}

remove_account() {
  local account_key=$1 label=$2 answer=''
  print -r -- "저장된 계정을 삭제합니다: $label"
  print -n -- '계속할까요? [y/N] '
  read -r answer || return 0
  if [[ $answer != [yY] ]]; then
    print -r -- '취소했습니다.'
    return 0
  fi
  codex-auth remove "$account_key"
}

logout_account() {
  print -r -- '현재 Codex 로그인을 해제합니다. 저장된 계정 삭제와는 별개입니다.'
  print -r -- '현재 계정의 저장된 인증도 다시 필요할 수 있습니다.'
  print -n -- '계속할까요? [y/N] '
  local answer=''
  read -r answer || return 0
  if [[ $answer != [yY] ]]; then
    print -r -- '취소했습니다.'
    return 0
  fi
  codex logout
}

case ${1:-} in
  --render) render_accounts "${2:-}" ;;
  --preview) preview_account "${2:-}" ;;
  --action)
    case ${2:-} in
      switch) switch_account "${3:?account key required}" ;;
      add) add_account ;;
      add-device) add_account --device-auth ;;
      remove) remove_account "${3:?account key required}" "${4:?account label required}" ;;
      logout) logout_account ;;
      *) print -u2 -- '알 수 없는 계정 작업입니다.'; exit 2 ;;
    esac
    ;;
  *) exec "$bin/workspace" accounts ;;
esac
