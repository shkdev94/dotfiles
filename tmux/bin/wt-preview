#!/usr/bin/env zsh
# fzf preview for a worktree path: session info, git status, recent log.
source "${0:A:h}/wt-lib"
dir=$1

print -P "%B%F{blue}${dir/#$HOME/~}%f%b"
if name=$(wt_session_for_path "$dir"); then
  print -P "%F{green}● session $name%f"
  tmux list-windows -t "=$name" -F '  #I:#W#{?window_active,*, } (#{pane_current_command})'
else
  print -P "%F{8}○ no session%f"
fi
print
git -C "$dir" -c color.status=always status -sb 2>/dev/null | head -15
print
git -C "$dir" log --oneline --color=always -8 2>/dev/null
