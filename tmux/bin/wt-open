#!/usr/bin/env zsh
# Open a worktree: reuse its tmux session or create one, then switch/attach.
set -euo pipefail
source "${0:A:h}/wt-lib"

dir=${1:?usage: wt-open <worktree-path>}
dir=${dir:A}

if ! name=$(wt_session_for_path "$dir"); then
  name=$(wt_session_name "$dir")
  # another checkout already owns this name -> disambiguate with parent dir
  tmux has-session -t "=$name" 2>/dev/null && name="$name-${dir:h:t}"
  tmux new-session -d -s "$name" -c "$dir"
  (( $+commands[nvim] )) && tmux send-keys -t "=$name" nvim C-m
fi

if [[ -n ${TMUX:-} ]]; then
  tmux switch-client -t "=$name"
else
  exec tmux attach-session -t "=$name"
fi
