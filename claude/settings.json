{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "agentPushNotifEnabled": true,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash",
      "Edit"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(.env)",
      "Read(.env.local)",
      "Agent(Explore)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(darwin-rebuild *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Glob|Grep|LSP|WebFetch|WebSearch|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/delegate-to-subagent.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-dangerous.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
