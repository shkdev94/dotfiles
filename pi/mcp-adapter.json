{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "figma-remote": {
      "url": "https://mcp.figma.com/mcp",
      "auth": "oauth",
      "oauth": {
        "clientName": "Codex"
      }
    },
    "spline": {
      "command": "/Applications/Spline.app/Contents/MacOS/Spline",
      "args": [
        "/Applications/Spline.app/Contents/Resources/spline-mcp.cjs"
      ],
      "env": {
        "ELECTRON_RUN_AS_NODE": "1"
      }
    },
    "atlassian": {
      "url": "https://mcp.atlassian.com/v2/mcp",
      "auth": "oauth"
    },
    "vercel": {
      "url": "https://mcp.vercel.com/",
      "auth": "oauth"
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "auth": "oauth",
      "protocolVersion": "auto"
    },
    "browser-use": {
      "command": "/run/current-system/sw/bin/browser-use",
      "args": [
        "--mcp"
      ]
    },
    "obsidian": {
      "url": "https://127.0.0.1:27124/mcp/",
      "caFile": "~/.config/obsidian-mcp/ca.crt",
      "auth": "bearer",
      "bearerTokenStore": true,
      "excludeTools": [
        "command_execute"
      ]
    },
    "vultr": {
      "url": "https://mcp.vultr.com/mcp"
    },
    "supabase": {
      "url": "https://mcp.supabase.com/mcp",
      "auth": "oauth"
    }
  },
  "settings": {
    "showStatusIcon": false
  }
}
