#!/usr/bin/env zsh
# Open the workspace with a terminal in this directory, or create one.
set -euo pipefail

if (( $# > 1 )) || [[ ${1:-} == -h || ${1:-} == --help ]]; then
  print -r -- 'usage: hw [directory]'
  (( $# <= 1 )) && exit 0
  exit 2
fi

cd -- "${1:-$PWD}"
dir=${PWD:A}

server_status=$(herdr status server --json)
if ! print -r -- "$server_status" | jq -e '.running' >/dev/null; then
  # A headless server lets us select the workspace before attaching the UI.
  nohup herdr server </dev/null >/dev/null 2>&1 &!
  ready=0
  for attempt in {1..150}; do
    if server_status=$(herdr status server --json) &&
      print -r -- "$server_status" | jq -e '.running' >/dev/null; then
      ready=1
      break
    fi
    sleep 0.1
  done
  if (( ! ready )); then
    print -u2 -- 'Herdr 서버가 15초 안에 시작되지 않았습니다.'
    exit 1
  fi
fi

panes=$(herdr pane list)
workspace_id=$(print -r -- "$panes" | jq -r --arg dir "$dir" '
  [.result.panes[] | select(.cwd == $dir) | .workspace_id] | first // empty
')

if [[ -z $workspace_id ]]; then
  created=$(herdr workspace create --cwd "$dir" --label "${dir:t}")
  workspace_id=$(print -r -- "$created" | jq -er '.result.workspace.workspace_id')
fi

herdr workspace focus "$workspace_id" >/dev/null

# Inside Herdr, switch the workspace without launching another client.
if [[ ${HERDR_ENV:-} != 1 ]]; then
  exec herdr
fi
